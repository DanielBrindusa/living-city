{
  "name": "living-city",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node scripts/build-branch.mjs && node --test tests/*.test.mjs",
    "build:branch": "node scripts/build-branch.mjs",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "@types/three": "^0.180.0"
  }
}
